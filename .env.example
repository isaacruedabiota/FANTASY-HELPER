# Copia este fichero a .env y rellena tus datos. .env esta en .gitignore.

# --- Mister ---
# Estas dos las rellena `fh mister sesion` a partir de un "Copiar como cURL"
# del navegador. Mister necesita LAS DOS: con la cookie sola rechaza la peticion.
MISTER_TOKEN=
MISTER_XAUTH=

# ID de tu liga en Mister. Las rutas no lo llevan (lo decide la sesion), asi que
# aqui solo sirve de etiqueta interna para el historico.
MISTER_LEAGUE_ID=

# --- General ---
# Temporada en curso, formato AAAA-AA
FH_SEASON=2026-27
# Ruta de la base de datos (por defecto data/fantasyhelper.db)
FH_DB_PATH=
# Nivel de log: DEBUG, INFO, WARNING
FH_LOG_LEVEL=INFO
