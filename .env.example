# Copia este fichero a .env y rellena tus datos. .env esta en .gitignore.

# --- Mister ---
MISTER_EMAIL=tu-email@ejemplo.com
MISTER_PASSWORD=tu-password
# Alternativa a email/password: pega aqui el token/cookie de sesion que veas en DevTools.
# Si esta relleno, tiene prioridad sobre email/password.
MISTER_TOKEN=

# ID de tu liga en Mister. Se rellena solo tras el primer `fh mister login`.
MISTER_LEAGUE_ID=

# --- General ---
# Temporada en curso, formato AAAA-AA
FH_SEASON=2026-27
# Ruta de la base de datos (por defecto data/fantasyhelper.db)
FH_DB_PATH=
# Nivel de log: DEBUG, INFO, WARNING
FH_LOG_LEVEL=INFO
