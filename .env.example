# Copia este fichero a .env y rellena tus datos. .env esta en .gitignore.

# --- Mister ---
# Estas dos las rellena `fh mister sesion` a partir de un "Copiar como cURL"
# del navegador. Mister necesita LAS DOS: con la cookie sola rechaza la peticion.
MISTER_TOKEN=
MISTER_XAUTH=

# ID de tu liga en Mister. Las rutas no lo llevan (lo decide la sesion), asi que
# aqui solo sirve de etiqueta interna para el historico.
MISTER_LEAGUE_ID=

# --- General ---
# Temporada en curso, formato AAAA-AA
FH_SEASON=2026-27
# Ruta de la base de datos (por defecto data/fantasyhelper.db)
FH_DB_PATH=
# Nivel de log: DEBUG, INFO, WARNING
FH_LOG_LEVEL=INFO

# Cada cuantos minutos capturar. Vacio = las dos capturas diarias de siempre
# (03:30 completa y 19:00 solo onces probables), que es lo que menos molesta a
# las fuentes. Con un numero, esa captura periodica SUSTITUYE a las dos diarias.
#
# Dos cosas antes de bajarlo:
#
#   - da frescura, NO mas historico. Los snapshots son una fila por dia y
#     entidad, asi que capturar cada media hora reescribe esa misma fila 48
#     veces. Para tener el valor hora a hora hay que cambiar el esquema.
#   - cada pasada son unas 45 peticiones contra Mister y FutbolFantasy CON TU
#     SESION. Cada 30 minutos son ~2.100 al dia frente a las ~65 de las dos
#     capturas diarias.
#
# El minimo aceptado son 5 minutos; por debajo se sube solo y se avisa.
FH_CAPTURE_EVERY_MINUTES=
